# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/expenseai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key-here

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here

# Replit Authentication
REPL_ID=your-replit-app-id
REPLIT_DOMAINS=your-app-domain.replit.app
ISSUER_URL=https://replit.com/oidc

# Optional: Stripe Price ID for subscriptions
STRIPE_PRICE_ID=price_your-stripe-price-id-here